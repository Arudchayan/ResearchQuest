{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "src",
    "e2e/smoke-no-supabase.spec.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.bench.ts",
    "src/**/*.bench.tsx",
    "src/strict-gate/fail.fixture.ts",
    "src/components/layout/LeftSidebar.tsx",
    "src/components/layout/SidebarNavTabs.tsx",
    "src/components/layout/FocusStudioWidget.tsx",
    "src/components/layout/useSidebarData.ts",
    "src/components/entities/NoteList.tsx",
    "src/components/entities/IdeaList.tsx",
    "e2e/**/*"
  ]
}
