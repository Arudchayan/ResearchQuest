    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.11.2",
    "react-router-dom": "^7",
    "recharts": "^2.12.4",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zod": "^3.24.1",
    "zustand": "^5.0.14"
