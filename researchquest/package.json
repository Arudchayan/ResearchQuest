{
  "name": "researchquest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm install --prefer-offline && vite",
    "build": "pnpm install --prefer-offline --config.confirmModulesPurge=false && rimraf node_modules/.vite-temp && tsc -b && vite build",
    "build:prod": "pnpm install --prefer-offline --config.confirmModulesPurge=false && rimraf node_modules/.vite-temp && tsc -b && BUILD_MODE=prod vite build --mode prod",
    "lint": "pnpm install --prefer-offline && eslint .",
    "lint:fix": "pnpm install --prefer-offline && eslint . --fix",
    "preview": "pnpm install --prefer-offline && vite preview",
    "install-deps": "pnpm install --prefer-offline --config.confirmModulesPurge=false",
    "clean": "rimraf node_modules .pnpm-store pnpm-lock.yaml && pnpm store prune",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run --pool forks --maxWorkers=2",
    "test:build": "vitest run --config vitest.build.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.43.8",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-virtual": "^3.13.26",
    "@uiw/codemirror-theme-github": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.13",
    "lucide-react": "^1.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-router-dom": "^5",
    "@vitejs/plugin-react": "^4.4.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.16",
    "@vitest/ui": "^4.1.0",
    "autoprefixer": "10.5.4",
    "deno": "^2.9.5",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "eslint-plugin-unicorn": "^57.0.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "supabase": "^2.114.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.31.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "overrides": {
      "glob": ">=10.5.0",
      "minimatch": ">=9.0.7",
      "rollup": ">=4.59.0",
      "flatted": ">=3.4.2",
      "picomatch": ">=4.0.4",
      "brace-expansion": ">=5.0.8",
      "mdast-util-to-hast": ">=13.2.1",
      "yaml": ">=2.8.3",
      "@babel/core": ">=7.29.6"
    }
  }
}
