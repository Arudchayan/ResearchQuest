# Prefer VITE_* (required in client). You can put this file in `researchquest/` or at the
# repository root — Vite loads the root `.env` for this app. `NEXT_PUBLIC_SUPABASE_*` from
# a root `.env` is also accepted as an alias for the two variables below.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_TEST_EMAIL=
VITE_TEST_PASSWORD=
