# =============================================================================
# ResearchQuest — Environment Variables
# =============================================================================
#
# Prefer VITE_* (required in client). You can put this file in `researchquest/`
# or at the repository root — Vite loads the root `.env` for this app.
# `NEXT_PUBLIC_SUPABASE_*` from a root `.env` is also accepted as an alias for
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY.
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Required (for database) ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Optional aliases (read from repository root .env) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Testing ---
VITE_TEST_EMAIL=
VITE_TEST_PASSWORD=

# Set to "1" to force no-Supabase mode (shows config error screen).
# Useful for Playwright smoke tests or development without a backend.
PLAYWRIGHT_TEST_NO_SUPABASE=

# Set to "1" to run with a fully local, seeded demo workspace.
# No Supabase project is required; sign in with any email and password.
VITE_DEMO_MODE=

# --- Build ---
# Set to any truthy value to enable the rollup-plugin-visualizer bundle analyzer.
ANALYZE=
